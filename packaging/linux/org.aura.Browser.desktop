[Desktop Entry]
Type=Application
Name=Aura
GenericName=Web Browser
Comment=A lightweight web browser with its own engine
Exec=aura %U
Icon=org.aura.Browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=org.aura.Browser
