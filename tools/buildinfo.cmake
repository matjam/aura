# Writes OUT (au_build.h): the short commit the tree was built from and
# that commit's date, for bug reports (src/browser/sysinfo.c). Run by the
# build on every pass; the file is written only when its text changes, so
# nothing is compiled again while the commit stays the same.
#
#   cmake -DSRC=<source dir> -DOUT=<file> -P tools/buildinfo.cmake
#
# The date is the commit's, not the build's: one commit gives the same
# bytes whenever it is built. Without git, or outside a checkout, both
# are empty and Aura shows the version alone. A "+" after the commit
# marks a tree with uncommitted changes to tracked files.
set(commit "")
set(date "")
execute_process(COMMAND git -C "${SRC}" rev-parse --short=7 HEAD
                OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    set(commit "")
endif()
if(commit)
    execute_process(COMMAND git -C "${SRC}" log -1 --format=%cd --date=short
                    OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND git -C "${SRC}" status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE dirty OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(dirty)
        set(commit "${commit}+")
    endif()
endif()
if(NOT commit MATCHES "^[0-9a-f+]*$" OR NOT date MATCHES "^[0-9-]*$")
    set(commit "")
    set(date "")
endif()
set(text "/* Generated by tools/buildinfo.cmake. */\n#define AU_BUILD_COMMIT \"${commit}\"\n#define AU_BUILD_DATE \"${date}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
