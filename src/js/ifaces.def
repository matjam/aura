/* Interfaces whose prototype objects are created in C (wrap.c), parents
 * first. IFACE(id, "Name", parent id). The prelude adds methods written
 * in JavaScript to the same prototypes. */
IFACE(EventTarget, "EventTarget", COUNT)
IFACE(Window, "Window", EventTarget)
IFACE(Node, "Node", EventTarget)
IFACE(Document, "Document", Node)
IFACE(HTMLDocument, "HTMLDocument", Document)
IFACE(DocumentFragment, "DocumentFragment", Node)
IFACE(ShadowRoot, "ShadowRoot", DocumentFragment)
IFACE(DocumentType, "DocumentType", Node)
IFACE(CharacterData, "CharacterData", Node)
IFACE(Text, "Text", CharacterData)
IFACE(CDATASection, "CDATASection", Text)
IFACE(Comment, "Comment", CharacterData)
IFACE(ProcessingInstruction, "ProcessingInstruction", CharacterData)
IFACE(Element, "Element", Node)
IFACE(SVGElement, "SVGElement", Element)
IFACE(MathMLElement, "MathMLElement", Element)
IFACE(HTMLElement, "HTMLElement", Element)
