/* The CSS properties Aura parses, cascades and computes.
 *
 * Include this file with the macros you need defined; the others default
 * to nothing.
 *
 *   P(id, "name", type, flags, group, field, extra, "initial")
 *       A longhand stored at GROUP.field of the computed style.
 *       type: T_KW (uint8_t keyword enum, extra = keyword list name from
 *       css_enums.h), T_LEN (AuLen, extra = allowed keyword mask LK_*),
 *       T_PX (float px, extra = keyword mask), T_COLOR (AuColor), T_NUM
 *       (float), T_INT (int32_t, extra = keyword mask), T_BLOB (AuCssBlob *,
 *       extra = parse function suffix), T_SPECIAL (extra = handler suffix).
 *       flags: F_INH inherited, F_NONNEG, F_PCT percentages allowed,
 *       F_QUIRK unitless lengths accepted in quirks mode.
 *       initial is CSS text, parsed at startup.
 *   L(id, "name", lgroup, side)
 *       A flow-relative longhand mapped to a physical one at cascade time.
 *   S(id, "name", expander)
 *       A shorthand; parse_sh_<expander> expands it into longhands.
 *   A("alias", id)
 *       A legacy or vendor-prefixed name parsed as id.
 */
#ifndef P
#define P(id, name, type, flags, group, field, extra, initial)
#endif
#ifndef L
#define L(id, name, lgroup, side)
#endif
#ifndef S
#define S(id, name, expander)
#endif
#ifndef A
#define A(alias, id)
#endif

/* ---- Inherited, common (INH) ---- */
P(color, "color", T_COLOR, F_INH, INH, color, 0, "canvastext")
P(font_size, "font-size", T_SPECIAL, F_INH | F_NONNEG | F_PCT | F_QUIRK, INH, font_size, font_size, "medium")
P(font_weight, "font-weight", T_SPECIAL, F_INH, INH, font_weight, font_weight, "normal")
P(font_style, "font-style", T_SPECIAL, F_INH, INH, font_style, font_style, "normal")
P(font_stretch, "font-stretch", T_SPECIAL, F_INH | F_NONNEG | F_PCT, INH, font_stretch, font_stretch, "normal")
P(font_variant_caps, "font-variant-caps", T_KW, F_INH, INH, font_variant_caps, FONT_VARIANT_CAPS, "normal")
P(font_family, "font-family", T_BLOB, F_INH, INH, font_family, font_family, "serif")
P(line_height, "line-height", T_SPECIAL, F_INH | F_NONNEG | F_PCT, INH, line_height, line_height, "normal")
P(text_align, "text-align", T_KW, F_INH, INH, text_align, TEXT_ALIGN, "start")
P(white_space_collapse, "white-space-collapse", T_KW, F_INH, INH, white_space_collapse, WHITE_SPACE_COLLAPSE, "collapse")
P(text_wrap_mode, "text-wrap-mode", T_KW, F_INH, INH, text_wrap_mode, TEXT_WRAP_MODE, "wrap")
P(direction, "direction", T_KW, F_INH, INH, direction, DIRECTION, "ltr")
P(writing_mode, "writing-mode", T_KW, F_INH, INH, writing_mode, WRITING_MODE, "horizontal-tb")
P(visibility, "visibility", T_KW, F_INH, INH, visibility, VISIBILITY, "visible")
P(list_style_type, "list-style-type", T_BLOB, F_INH, INH, list_style_type, list_style_type, "disc")
P(list_style_position, "list-style-position", T_KW, F_INH, INH, list_style_position, LIST_STYLE_POSITION, "outside")

