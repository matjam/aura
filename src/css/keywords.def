/* CSS keywords, function names, units-free identifiers used by the parser
 * and the computed style. KW(identifier, "string"). The strings are
 * interned at startup (au_css_init) and mapped to the dense AU_K_* ids, so
 * a keyword that is also an HTML or SVG name (table, width, fill) shares
 * that atom instead of duplicating it in a .def file.
 * Keep the strings lowercase; CSS keywords are ASCII case-insensitive and
 * the tokenizer lowercases before lookup. */
KW(initial, "initial")
KW(inherit, "inherit")
KW(unset, "unset")
KW(revert, "revert")
KW(revert_layer, "revert-layer")
KW(default_, "default")
KW(auto_, "auto")
KW(none, "none")
KW(normal, "normal")
KW(all, "all")
KW(important, "important")
KW(and_, "and")
KW(or_, "or")
KW(not_, "not")
KW(only, "only")
KW(of, "of")
KW(even, "even")
KW(odd, "odd")
KW(n, "n")
KW(selector, "selector")
KW(layer, "layer")
KW(supports, "supports")
