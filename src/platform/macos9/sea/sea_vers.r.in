/* Generated from sea_vers.r.in: the version, from AU_VERSION in
 * src/browser/credits.h. */
#include "MacTypes.r"

resource 'vers' (1) {
	0x@AURA_VERS_MAJOR@, 0x@AURA_VERS_MINOR@, @AURA_VERS_STAGE@, 0x00, verUS,
	"@AURA_VERSION@",
	"Aura @AURA_VERSION@ Installer"
};

resource 'vers' (2) {
	0x@AURA_VERS_MAJOR@, 0x@AURA_VERS_MINOR@, @AURA_VERS_STAGE@, 0x00, verUS,
	"@AURA_VERSION@",
	"Aura @AURA_VERSION@"
};
