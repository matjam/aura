Reading a module's bytecode without resolving its imports.

JS_ReadModule asks the module loader for every import of the module it
reads. A browser's loader cannot answer before the import is fetched,
so the read failed and the embedder could not use stored bytecode for
a module whose imports are not loaded yet.

With JS_READ_OBJ_NO_RESOLVE the reader leaves the imports alone. The
module comes back as JS_EVAL_FLAG_NO_RESOLVE leaves a compiled one
(patch 0010): loaded, unresolved, for the caller to resolve with
JS_ResolveModule once its imports can be loaded. js_resolve_module asks
the loader for each import itself, so nothing else changes. Aura reads
the modules it keeps in its script cache this way.

--- a/quickjs.c
+++ b/quickjs.c
@@ -41223,6 +41223,7 @@ typedef struct BCReaderState {
     bool allow_sab;
     bool allow_bytecode;
     bool allow_reference;
+    bool no_resolve; /* Aura: JS_READ_OBJ_NO_RESOLVE */
     JSSourceText *source_ref; /* JS_ReadObjectSource: the script's text */
     /* object references */
     JSObject **objects;
@@ -41904,6 +41905,11 @@ static JSValue JS_ReadModule(BCReaderState *s)
             // JS_WriteModule() does not serialize modules transitively
             // because that doesn't work for C modules and is also prone
             // to loading the same JS module twice.
+            /* Aura: with JS_READ_OBJ_NO_RESOLVE the caller resolves the
+               module (JS_ResolveModule) once its imports can be loaded;
+               js_resolve_module asks for each of them again anyway. */
+            if (s->no_resolve)
+                continue;
             *pm = js_host_resolve_imported_module_atom(s->ctx, m->module_name,
                                                        rme->module_name,
                                                        rme->attributes);
@@ -42513,6 +42519,7 @@ JSValue JS_ReadObject2(JSContext *ctx, const uint8_t *buf, size_t buf_len,
     s->allow_bytecode = ((flags & JS_READ_OBJ_BYTECODE) != 0);
     s->allow_sab = ((flags & JS_READ_OBJ_SAB) != 0);
     s->allow_reference = ((flags & JS_READ_OBJ_REFERENCE) != 0);
+    s->no_resolve = ((flags & JS_READ_OBJ_NO_RESOLVE) != 0);
     if (s->allow_bytecode)
         s->first_atom = JS_ATOM_END;
     else
@@ -42551,6 +42558,7 @@ JSValue JS_ReadObjectSource(JSContext *ctx, const uint8_t *buf, size_t buf_len,
     s->ptr = buf;
     s->allow_bytecode = true;
     s->allow_reference = ((flags & JS_READ_OBJ_REFERENCE) != 0);
+    s->no_resolve = ((flags & JS_READ_OBJ_NO_RESOLVE) != 0);
     s->first_atom = JS_ATOM_END;
     s->source_ref = js_source_text_script(ctx, source, (int)source_len);
     if (!s->source_ref)
--- a/quickjs.h
+++ b/quickjs.h
@@ -1385,6 +1385,8 @@ JS_EXTERN uint8_t *JS_WriteObject2(JSContext *ctx, size_t *psize, JSValueConst o
    writer in the same process (e.g. another Worker on the same runtime). */
 #define JS_READ_OBJ_SAB       (1 << 2) /* allow SharedArrayBuffer */
 #define JS_READ_OBJ_REFERENCE (1 << 3) /* allow object references */
+#define JS_READ_OBJ_NO_RESOLVE (1 << 4) /* Aura: a module is read without resolving its imports; the
+                                           caller calls JS_ResolveModule, as after JS_EVAL_FLAG_NO_RESOLVE */
 JS_EXTERN JSValue JS_ReadObject(JSContext *ctx, const uint8_t *buf, size_t buf_len, int flags);
 JS_EXTERN JSValue JS_ReadObjectSource(JSContext *ctx, const uint8_t *buf, size_t buf_len, int flags,
                                       const char *source, size_t source_len);
