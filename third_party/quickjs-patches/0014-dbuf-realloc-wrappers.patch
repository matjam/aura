Call the DynBuf realloc functions through their own type.

String.prototype.normalize and String.prototype.localeCompare passed
js_realloc_rt and js_realloc to unicode_normalize cast to
DynBufReallocFunc, whose first parameter is void * where theirs is
JSRuntime * or JSContext *. A call through a pointer of another
function type is undefined behaviour, and UBSan's -fsanitize=function
(Clang on Linux) reports it. Two static wrappers with the right type
take their place. The generated code is unchanged.

--- a/quickjs.c
+++ b/quickjs.c
@@ -2208,6 +2208,19 @@
     return ret;
 }

+/* DynBufReallocFunc wrappers: calling js_realloc_rt or js_realloc through
+   a DynBufReallocFunc pointer is undefined behaviour (the first parameter
+   types differ). */
+static void *js_dbuf_realloc_rt(void *opaque, void *ptr, size_t size)
+{
+    return js_realloc_rt(opaque, ptr, size);
+}
+
+static void *js_dbuf_realloc_ctx(void *opaque, void *ptr, size_t size)
+{
+    return js_realloc(opaque, ptr, size);
+}
+
 size_t js_malloc_usable_size(JSContext *ctx, const void *ptr)
 {
     return js_malloc_usable_size_rt(ctx->rt, ptr);
@@ -49288,7 +49301,7 @@

     // TODO(bnoordhuis) skip normalization when input is latin1
     an = unicode_normalize(&ts, as, an, UNICODE_NFC, ctx,
-                           (DynBufReallocFunc *)js_realloc);
+                           js_dbuf_realloc_ctx);
     if (an == -1)
         goto exception;
     js_free(ctx, as);
@@ -49296,7 +49309,7 @@

     // TODO(bnoordhuis) skip normalization when input is latin1
     bn = unicode_normalize(&ts, bs, bn, UNICODE_NFC, ctx,
-                           (DynBufReallocFunc *)js_realloc);
+                           js_dbuf_realloc_ctx);
     if (bn == -1)
         goto exception;
     js_free(ctx, bs);
@@ -49438,7 +49451,7 @@
     }

     out_len = unicode_normalize(&out_buf, buf, buf_len, n_type,
-                                ctx->rt, (DynBufReallocFunc *)js_realloc_rt);
+                                ctx->rt, js_dbuf_realloc_rt);
     js_free(ctx, buf);
     if (out_len < 0)
         return JS_EXCEPTION;
