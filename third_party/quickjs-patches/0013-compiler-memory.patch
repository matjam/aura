+/* Aura: a block outside the small-block arenas, for the compiler's
+   working arrays and buffers. They live until their function is
+   compiled; in arenas they left holes between the atoms and small
+   functions made at the same time (4.5 MB of free arena space after
+   compiling a 9.8 MB script). A block made here stays outside the
+   arenas when it is reallocated or freed with the usual calls. */
+static void *js_malloc_unpooled_rt(JSRuntime *rt, size_t size)
+{
+    void *ptr;
+    JSMallocState *s;
+
+    if (unlikely(size == 0))
+        return NULL;
+    s = &rt->malloc_state;
+    if (unlikely(s->malloc_size + size > s->malloc_limit - 1))
+        return NULL;
+    ptr = arena_malloc_large(rt, size);
+    if (!ptr)
+        return NULL;
+    s->malloc_count++;
+    s->malloc_size += js_arena_usable_size(rt, ptr) + MALLOC_OVERHEAD;
+    return ptr;
+}
