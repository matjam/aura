+/* Aura: js_realloc, but a new block is made outside the arenas
+   (js_malloc_unpooled_rt) */
+static void *js_realloc_unpooled(JSContext *ctx, void *ptr, size_t size)
+{
+    void *ret;
+
+    if (ptr) {
+        /* a block that already holds size bytes is kept: the system's
+           realloc is slower than an arena's, and buffers grow in many
+           small steps */
+        if (size != 0 && size <= js_malloc_usable_size(ctx, ptr))
+            return ptr;
+        return js_realloc(ctx, ptr, size);
+    }
+    if (size == 0)
+        return NULL;
+    ret = js_malloc_unpooled_rt(ctx->rt, size);
+    if (unlikely(!ret)) {
+        JS_ThrowOutOfMemory(ctx);
+        return NULL;
+    }
+    return ret;
 }

