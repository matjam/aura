+/* Aura: a source position in phase 1 and 2 bytecode takes 5 bytes
+   (OP_source_loc2) when its line and column are below 65536, 9 bytes
+   (OP_source_loc) otherwise. In a large script they were a third of the
+   phase 1 bytecode, which is held for every function until the whole
+   script is parsed. */
+static bool is_source_loc(int op)
+{
+    return op == OP_source_loc || op == OP_source_loc2;
+}
+
+static void get_source_loc(const uint8_t *p, int *line_num, int *col_num)
+{
+    uint32_t v;
+
+    if (p[0] == OP_source_loc2) {
+        v = get_u32(p + 1);
+        *line_num = v >> 16;
+        *col_num = v & 0xffff;
+    } else {
+        *line_num = get_u32(p + 1);
+        *col_num = get_u32(p + 5);
+    }
+}
+
+/* writes the opcode to p[0..8], returns its size */
+static int encode_source_loc(uint8_t *p, int line_num, int col_num)
+{
+    if ((uint32_t)line_num <= 0xffff && (uint32_t)col_num <= 0xffff) {
+        p[0] = OP_source_loc2;
+        put_u32(p + 1, ((uint32_t)line_num << 16) | (uint32_t)col_num);
+        return 5;
+    }
+    p[0] = OP_source_loc;
+    put_u32(p + 1, line_num);
+    put_u32(p + 5, col_num);
+    return 9;
 }

+static void put_source_loc(DynBuf *bc, int line_num, int col_num)
+{
+    uint8_t op[9];
+
+    dbuf_put(bc, op, encode_source_loc(op, line_num, col_num));
