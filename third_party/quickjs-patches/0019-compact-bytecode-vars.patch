+/* Aura: what a compiled function keeps of each argument and local (8
+   bytes instead of the 20 of a JSVarDef): the name, for errors and eval,
+   and how a closure captures it. A function that contains a direct eval
+   also keeps each local's scope (JSBytecodeVarScope, bc_var_scopes()),
+   which compiling the eval reads. */
+typedef struct JSBytecodeVar {
+    JSAtom var_name;
+    uint16_t var_ref_idx; /* if is_captured */
+    uint8_t is_const : 1;
+    uint8_t is_lexical : 1;
+    uint8_t is_captured : 1;
+    uint8_t var_kind : 4; /* see JSVarKindEnum */
+} JSBytecodeVar;
+
+typedef struct JSBytecodeVarScope {
+    int scope_level;
+    int scope_next;
+} JSBytecodeVarScope;
