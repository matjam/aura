+/* Aura: set_closure_from_var and is_var_in_arg_scope for a compiled
+   function's locals */
+static void set_closure_from_bvar(JSContext *ctx, JSClosureVar *cv,
+                                  const JSBytecodeVar *vd, int var_idx)
+{
+    cv->closure_type = JS_CLOSURE_LOCAL;
+    cv->is_const = vd->is_const;
+    cv->is_lexical = vd->is_lexical;
+    cv->var_kind = vd->var_kind;
+    cv->var_idx = var_idx;
+    cv->var_name = JS_DupAtom(ctx, vd->var_name);
+}
+
+static bool is_bvar_in_arg_scope(const JSBytecodeVar *vd)
+{
+    return (vd->var_name == JS_ATOM_home_object ||
+            vd->var_name == JS_ATOM_this_active_func ||
+            vd->var_name == JS_ATOM_new_target ||
+            vd->var_name == JS_ATOM_this ||
+            vd->var_name == JS_ATOM__arg_var_ ||
+            vd->var_kind == JS_VAR_FUNCTION_NAME);
+}
