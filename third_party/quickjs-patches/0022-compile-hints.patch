+
+/* Aura */
+void JS_SetCompileHints(JSRuntime *rt, JSCompileHintsFunc *hints, JSLazyCompiledFunc *compiled,
+                        void *opaque, size_t min_len)
+{
+    rt->hints_fn = hints && compiled ? hints : NULL;
+    rt->hints_compiled = hints && compiled ? compiled : NULL;
+    rt->hints_opaque = opaque;
+    rt->hints_min_len = min_len;
+}
+
+/* Aura: whether the function at ofs is to be compiled with its script
+   (JS_SetCompileHints) */
+static bool js_eager_function(JSRuntime *rt, int ofs)
+{
+    size_t lo = 0, hi = rt->eager_count;
+
+    if (ofs < 0)
+        return false;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        uint32_t v = rt->eager_ofs[mid];
+        if (v == (uint32_t)ofs)
+            return true;
+        if (v < (uint32_t)ofs)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return false;
 }
 
