                     r = (int64_t)JS_VALUE_GET_INT(op1) + JS_VALUE_GET_INT(op2);
                     if (unlikely(r < INT32_MIN || r > INT32_MAX))
-                        sp[-2] = js_float64(r);
+                        sp[-2] = js_float64((double)JS_VALUE_GET_INT(op1) +
+                                            (double)JS_VALUE_GET_INT(op2));
                     else
                         sp[-2] = js_int32(r);
                     sp--;
@@ -20553,7 +20567,8 @@
                     r = (int64_t)JS_VALUE_GET_INT(*pv) +
                         JS_VALUE_GET_INT(sp[-1]);
                     if (unlikely((int)r != r))
-                        *pv = __JS_NewFloat64((double)r);
+                        *pv = __JS_NewFloat64((double)JS_VALUE_GET_INT(*pv) +
+                                              (double)JS_VALUE_GET_INT(sp[-1]));
                     else
                         *pv = js_int32(r);
