+/* Aura: the weak references to an object, kept by the runtime instead
+   of a pointer in every object (JSObject.has_weak_ref). A node lives
+   from the first weak reference to the object until the object is
+   freed; nodes are separate blocks, so a pointer to node->first stays
+   valid while other nodes come and go. */
+typedef struct JSWeakObjNode {
+    JSObject *obj;
+    JSWeakRefRecord *first;
+    struct JSWeakObjNode *next;
+} JSWeakObjNode;
+
+static inline uint32_t weak_obj_hash_of(const JSObject *p, uint32_t size)
+{
+    uintptr_t h = (uintptr_t)p >> 3;
+    return ((uint32_t)h * 2654435761u) & (size - 1);
+}
+
+static JSWeakObjNode *weak_obj_find(JSRuntime *rt, const JSObject *p)
+{
+    JSWeakObjNode *n;
+    if (!rt->weak_obj_hash_size)
+        return NULL;
+    for (n = rt->weak_obj_hash[weak_obj_hash_of(p, rt->weak_obj_hash_size)]; n; n = n->next) {
+        if (n->obj == p)
+            return n;
+    }
+    return NULL;
+}
+
+static void weak_obj_grow(JSRuntime *rt)
+{
+    uint32_t i, size = rt->weak_obj_hash_size ? rt->weak_obj_hash_size * 2 : 16;
+    JSWeakObjNode **tab = js_mallocz_rt(rt, sizeof(tab[0]) * size);
+    if (!tab)
+        return; /* the chains grow longer instead */
+    for (i = 0; i < rt->weak_obj_hash_size; i++) {
+        JSWeakObjNode *n, *next;
+        for (n = rt->weak_obj_hash[i]; n; n = next) {
+            uint32_t h = weak_obj_hash_of(n->obj, size);
+            next = n->next;
+            n->next = tab[h];
+            tab[h] = n;
+        }
+    }
+    js_free_rt(rt, rt->weak_obj_hash);
+    rt->weak_obj_hash = tab;
+    rt->weak_obj_hash_size = size;
+}
+
+/* Makes sure the object target (when it is one) has a node for weak
+   references, so that insert_weakref_record cannot fail. Called before
+   anything else is set up for the new reference. */
+static int weak_obj_prepare(JSContext *ctx, JSValueConst target)
+{
+    JSRuntime *rt = ctx->rt;
+    JSObject *p;
+    JSWeakObjNode *n;
+    uint32_t h;
+    if (JS_VALUE_GET_TAG(target) != JS_TAG_OBJECT)
+        return 0;
+    p = JS_VALUE_GET_OBJ(target);
+    if (p->has_weak_ref)
+        return 0;
+    if (rt->weak_obj_count >= rt->weak_obj_hash_size)
+        weak_obj_grow(rt);
+    if (!rt->weak_obj_hash_size)
+        return -1;
+    n = js_malloc(ctx, sizeof(*n));
+    if (!n)
+        return -1;
+    n->obj = p;
+    n->first = NULL;
+    h = weak_obj_hash_of(p, rt->weak_obj_hash_size);
+    n->next = rt->weak_obj_hash[h];
+    rt->weak_obj_hash[h] = n;
+    rt->weak_obj_count++;
+    p->has_weak_ref = 1;
+    return 0;
+}
+
+/* The object is being freed: its weak references go, then its node. */
+static void weak_obj_reset(JSRuntime *rt, JSObject *p)
+{
+    JSWeakObjNode *n = weak_obj_find(rt, p), **pn;
+    if (!n)
+        return;
+    reset_weak_ref(rt, &n->first);
+    /* freeing the references' values may have changed other chains, not
+       this node */
+    pn = &rt->weak_obj_hash[weak_obj_hash_of(p, rt->weak_obj_hash_size)];
+    while (*pn != n)
+        pn = &(*pn)->next;
+    *pn = n->next;
+    rt->weak_obj_count--;
+    p->has_weak_ref = 0;
+    js_free_rt(rt, n);
+}
