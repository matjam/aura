# Inflate tests, included by tests/codec/CMakeLists.txt. The vectors are
# generated by gen-inflate-vectors.py (Python's zlib) and committed.
#
# To run a long fuzz session, build fuzz_inflate with sanitizers and run
#   fuzz_inflate ITERATIONS SEED tests/codec/inflate-vectors/*
file(GLOB INFLATE_VECTORS CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/inflate-vectors/*.z
     ${CMAKE_CURRENT_SOURCE_DIR}/inflate-vectors/*.gz ${CMAKE_CURRENT_SOURCE_DIR}/inflate-vectors/*.raw)

add_executable(test_inflate ${CMAKE_CURRENT_SOURCE_DIR}/test_inflate.c)
target_link_libraries(test_inflate aura_engine)
target_include_directories(test_inflate PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
add_test(NAME codec_inflate COMMAND test_inflate ${CMAKE_CURRENT_SOURCE_DIR}/brotli-vectors ${INFLATE_VECTORS})

add_executable(fuzz_inflate ${CMAKE_CURRENT_SOURCE_DIR}/fuzz_inflate.c)
target_link_libraries(fuzz_inflate aura_engine)
target_include_directories(fuzz_inflate PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
add_test(NAME codec_inflate_fuzz COMMAND fuzz_inflate 20000 1 ${INFLATE_VECTORS})
